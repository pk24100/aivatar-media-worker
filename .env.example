LIVEKIT_API_KEY=API..
LIVEKIT_API_SECRET=X6i..
LIVEKIT_TOKEN=ey...
# Must match the backend secret used to verify worker lifecycle callback JWTs.
WORKER_AUTH_SECRET=bb..
# Backend internal base URL, without a trailing slash. Required for ownership
# claims, heartbeats, and terminal lifecycle callbacks.
BACKEND_INTERNAL_URL=http://host.docker.internal:5000
# Heartbeat cadence in seconds. Keep this safely below WORKER_OWNER_LEASE_MS.
WORKER_LIFECYCLE_HEARTBEAT_SECONDS=15
# Stable, unique worker process or container identity used for owner fencing.
AIVATAR_WORKER_INSTANCE_ID=worker-local-1

# Dev:
# ALLOWED_IMAGE_DOMAINS=pub-{hash}.r2.dev
# Prod:
ALLOWED_IMAGE_DOMAINS=avatars.facemode.io

# Persistent WebSocket session policy
FACEMODE_WS_AUTOSTART_MAX_TOKEN_AGE_S=300
# Silence gap (ms) for inferred utterance boundaries; 0 disables inference (explicit controls still work), allowed range 100-5000
FACEMODE_UTTERANCE_SILENCE_MS=800
WS_INACTIVITY_TIMEOUT=45
NO_AUDIO_SESSION_TIMEOUT=120
SESSION_IDLE_CHECK_INTERVAL=5

# Idle video delivery
IDLE_VIDEO_MAX_BYTES=20971520IDLE_VIDEO_MAX_FRAMES=750
IDLE_VIDEO_MAX_DIMENSION=1024
IDLE_TIMEOUT_MS=500
# Read-only access to public default clips for Modal snapshot creation.
DEFAULT_IDLE_VIDEO_R2_BUCKET_NAME=facemode-idle-videos-default
IDLE_VIDEO_R2_ENDPOINT=https://account-id.r2.cloudflarestorage.com
IDLE_VIDEO_R2_ACCESS_KEY_ID=replace_me
IDLE_VIDEO_R2_SECRET_ACCESS_KEY=replace_me

# Sentry (error monitoring, optional - leave SENTRY_DSN empty to log only)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
