LIVEKIT_API_KEY=API..
LIVEKIT_API_SECRET=X6i..
LIVEKIT_TOKEN=ey...
WORKER_AUTH_SECRET=bb..

# Dev:
# ALLOWED_IMAGE_DOMAINS=pub-{hash}.r2.dev
# Prod:
ALLOWED_IMAGE_DOMAINS=avatars.facemode.io

# Persistent WebSocket session policy
WS_INACTIVITY_TIMEOUT=45
NO_AUDIO_SESSION_TIMEOUT=120
SESSION_IDLE_CHECK_INTERVAL=5

# Idle video delivery
IDLE_VIDEO_MAX_BYTES=20971520
IDLE_VIDEO_MAX_FRAMES=750
IDLE_VIDEO_MAX_DIMENSION=1024
IDLE_TIMEOUT_MS=500
# Read-only access to public default clips for Modal snapshot creation.
DEFAULT_IDLE_VIDEO_R2_BUCKET_NAME=facemode-idle-videos-default
IDLE_VIDEO_R2_ENDPOINT=https://account-id.r2.cloudflarestorage.com
IDLE_VIDEO_R2_ACCESS_KEY_ID=replace_me
IDLE_VIDEO_R2_SECRET_ACCESS_KEY=replace_me
